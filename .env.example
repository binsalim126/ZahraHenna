# -------------------------------------------------------------
# ZAHRA HENNA - Environment Configuration
# -------------------------------------------------------------

# Supabase PostgreSQL Connection String
# 1. DATABASE_URL: Use Transaction pooler (port 6543) or Direct (port 5432)
# Example: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional: Direct connection for Prisma migrations (port 5432)
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Storage / API (for product image uploads)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# NextAuth Configuration
NEXTAUTH_SECRET="zahra_henna_super_secret_jwt_key_at_least_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# Initial Admin Credentials (used during database seeding)
ADMIN_NAME="Zahra Admin"
ADMIN_EMAIL="admin@zahrahenna.com"
ADMIN_PASSWORD="ZahraAdminSecurePassword2026!"

# Payments (Razorpay primary, Stripe optional)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Stripe (Optional alternative)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email Notifications (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="orders@zahrahenna.com"
ADMIN_NOTIFICATION_EMAIL="admin@zahrahenna.com"

# Public Brand Details
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="+919876543210"
NEXT_PUBLIC_BRAND_NAME="ZAHRA HENNA"
